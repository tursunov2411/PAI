{
  "installCommand": "npm install",
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/[...route].js": {
      "maxDuration": 60,
      "includeFiles": "backend/**"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
