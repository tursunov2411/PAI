{
  "name": "sunnatilla-ai",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run prisma:generate --workspace backend && npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "lint:frontend": "npm run lint --workspace frontend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:deploy": "npm run prisma:deploy --workspace backend"
  }
}
